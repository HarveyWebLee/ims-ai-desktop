{
  "name": "@ims/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "IMS AI 桌面端 Electron 应用",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,less}\" \"electron/**/*.{ts,js}\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,less}\" \"electron/**/*.{ts,js}\" \"*.{json,ts}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@ims/agent-core": "workspace:*",
    "@ims/desktop-api": "workspace:*",
    "@ims/shared-types": "workspace:*",
    "antd": "5.23.0",
    "dayjs": "^1.11.12",
    "nanoid": "^5.1.5",
    "qs": "^6.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-markdown": "^9.0.3",
    "zustand": "^5.0.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@types/qs": "^6.9.18",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "less": "^4.2.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
