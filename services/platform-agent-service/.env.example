# Agent 服务环境变量（复制为 .env，勿提交）
# 架构：docs/architecture/08-dev-guide.md
PORT=8008

# Platform MCP（双层工具执行面；联调建议先 mcp.sh，但 Agent 可不依赖其先启动）
PLATFORM_MCP_URL=http://127.0.0.1:8010/mcp
# false（默认）= MCP 未就绪时 Agent 仍启动，调工具时再降级；true=启动预热失败则退出
AGENT_MCP_REQUIRED=false
AGENT_MCP_WARMUP_ON_START=true
# 工具列表缓存 TTL（秒）
AGENT_MCP_CACHE_TTL_SECONDS=300
# 追加外部 MCP，示例：{"ext":{"transport":"streamable_http","url":"http://127.0.0.1:8020/mcp"}}
AGENT_MCP_EXTRA_SERVERS_JSON=
# Agent MCP Gateway：须 Bearer JWT，或配置密钥后用 X-Agent-Mcp-Key（空密钥不再匿名放行）
AGENT_MCP_GATEWAY_KEY=
# 写工具 catalog.required_permissions：true=JWT 未声明 permissions 则拒绝（生产保持 true）
# 若平台 JWT 尚无 permissions/scopes 声明，本地联调可临时 false
AGENT_TOOL_PERMISSION_FAIL_CLOSED=true
# P2-3：空 model_id / auto 时按意图从已启用 catalog 选型（仅目录内模型）
AGENT_MODEL_ROUTE_ENABLED=true
# P2-1 运行时 Hooks（工具前后；不替代 HITL interrupt）
AGENT_TOOL_HOOKS_ENABLED=true
# 逗号分隔黑名单工具名，例：download_file,send_device_cmd
AGENT_TOOL_HOOK_DENY_TOOLS=
# true=每次工具后额外写 tool_hook_after 审计（默认 false，避免与 tool_end 重复）
AGENT_TOOL_HOOKS_AUDIT_AFTER=false

# 意图识别：true=AI 直接识别（classify 只出 react，默认）；false=原正则/门控路径（回滚）
AGENT_INTENT_AI_FIRST=true

# Phase C2：多步 Plan 执行前确认（plan_confirm HITL）
AGENT_PLAN_CONFIRM_ENABLED=true
AGENT_PLAN_CONFIRM_WRITE_ONLY=true
AGENT_PREFLIGHT_ENABLED=true
AGENT_LLM_PLAN_ENABLED=true
# Plan 步骤参数：true=LLM 抽参（推荐）；false=仅空槽骨架 + 工具 HITL
AGENT_LLM_PLAN_PARAMS_ENABLED=true
# Phase P1/P2：BPMN 条件执行 + LLM 编译（代码默认 false；本地联调建议双开）
# 预发建议双 true；生产先 CONDITION 再 LLM
AGENT_BPMN_CONDITION_EXEC=true
AGENT_BPMN_LLM_COMPILE=true

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# PLATFORM_API_BASE 默认读仓根 .env.shared；仅当本服务要覆盖时取消注释
# PLATFORM_API_BASE=http://127.0.0.1:18001/api/app

TRANSCRIBE_MODEL=qwen3-asr-flash
TRANSCRIBE_MAX_BYTES=10485760
TRANSCRIBE_TIMEOUT_SECONDS=120
# 语音转写后 Qdrant+LLM 领域纠错（失败回退 ASR 原文；见 docs/architecture/05-qdrant-rag.md）
TRANSCRIBE_RAG_ENABLED=true
TRANSCRIBE_RAG_TOP_K=2
TRANSCRIBE_CORRECT_MODEL=qwen-flash
# 纠错超时宜短；多数「已正确」请求会跳过 LLM，仅检索耗时
TRANSCRIBE_CORRECT_TIMEOUT_SECONDS=6
TRANSCRIBE_CORRECT_MIN_SCORE=0.42
TRANSCRIBE_CORRECT_SNIPPET_CHARS=160
TRANSCRIBE_CORRECT_MAX_TOKENS=48
TRANSCRIBE_DICTIONARY_ENABLED=true
# Redis 纠错映射 TTL（秒，默认 30 天）
TRANSCRIBE_CORRECT_CACHE_TTL_SECONDS=2592000
# 声纹门禁唯一开关（桌面经 GET /api/agent/voiceprints/config 同步；true 时须选用户并核验）
VOICEPRINT_ENABLED=false
VOICEPRINT_MODEL_ID=iic/speech_eres2net_large_sv_zh-cn_3dspeaker_16k
VOICEPRINT_EMBEDDING_DIM=512
# 空=自动选择 cpu/cuda
VOICEPRINT_DEVICE=
VOICEPRINT_ENROLL_MIN_SAMPLES=3
VOICEPRINT_ENROLL_MAX_SAMPLES=5
VOICEPRINT_ENROLL_MIN_SPEECH_MS=8000
VOICEPRINT_VERIFY_MIN_SPEECH_MS=2000
VOICEPRINT_QDRANT_COLLECTION=agent_voiceprints
VOICEPRINT_SEARCH_TOP_K=20
VOICEPRINT_SCORE_AGG=max
VOICEPRINT_THRESHOLD_ASSISTANT_GATE=0.83
VOICEPRINT_THRESHOLD_MEETING=0.87
VOICEPRINT_THRESHOLD_IDENTIFY=0.80
VOICEPRINT_CALIBRATION_PATH=
VOICEPRINT_REDIS_TTL_SEC=3600
VOICEPRINT_VAD_ENABLED=true
# DeepFilterNet 与当前 numpy 主依赖不兼容时保持 false，或另建隔离环境手动安装
VOICEPRINT_DENOISE_ENABLED=false
# 流式分片并行
TRANSCRIBE_STREAM_ENABLED=true
TRANSCRIBE_PIPELINE_WORKERS=4
TRANSCRIBE_STREAM_SESSION_TTL_SECONDS=600
TRANSCRIBE_STREAM_FINALIZE_WAIT_SECONDS=12
# Realtime ASR（词级 partial；北京地域）
TRANSCRIBE_REALTIME_ENABLED=true
TRANSCRIBE_REALTIME_MODEL=qwen3-asr-flash-realtime
TRANSCRIBE_REALTIME_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
TRANSCRIBE_REALTIME_SAMPLE_RATE=16000

POSTGRES_DSN=postgresql://agent:agent@127.0.0.1:16543/platform_agent

# Redis（语音纠错 Cache；docker-compose 宿主机 13386 → 6379）
REDIS_URL=redis://127.0.0.1:13386/0

# Qdrant（见 docs/architecture/05-qdrant-rag.md）
QDRANT_URL=http://127.0.0.1:16333
QDRANT_COLLECTION=platform_knowledge
QDRANT_VECTOR_SIZE=1024
EMBEDDING_PROVIDER=dashscope
# 文本：qwen3.7-text-embedding（默认 1024，可选 2560/2048/1536/1024/768/512/256）；走 OpenAI compatible-mode
# 多模态：qwen3-vl-embedding（须改 QDRANT_VECTOR_SIZE 并对齐；走多模态原生 API）
EMBEDDING_MODEL=qwen3.7-text-embedding
VECTOR_CHUNK_SIZE=800
VECTOR_CHUNK_OVERLAP=120
# 单次 upsert 点数；过大易触发 Qdrant 32MB JSON 限制
VECTOR_UPSERT_BATCH_SIZE=64
RAG_TOP_K=4
# 被动 RAG 单条截断字符（防 HumanMessage 膨胀）
AGENT_RAG_PASSIVE_SNIPPET_CHARS=220
# 运营上传落盘目录；空=仓根 prj-docs（与 kb --dir prj-docs 对齐）
KNOWLEDGE_DOCS_DIR=

# P1-3 知识检索 Subagent（retrieve_knowledge 摘要回主 agent）
AGENT_SUBAGENT_KNOWLEDGE_ENABLED=true
AGENT_SUBAGENT_KNOWLEDGE_LLM=true
AGENT_SUBAGENT_KNOWLEDGE_MODEL=qwen-flash
AGENT_SUBAGENT_KNOWLEDGE_TIMEOUT_SECONDS=8
AGENT_SUBAGENT_KNOWLEDGE_MAX_TOKENS=400
AGENT_SUBAGENT_KNOWLEDGE_SNIPPET_CHARS=220

# 运行时 Playbook（Skills 等价；见 app/playbooks/）
AGENT_PLAYBOOK_ENABLED=true
# 空=内置 app/playbooks；可指向外部目录热更
AGENT_PLAYBOOK_DIR=
AGENT_PLAYBOOK_MAX_MATCHES=2
# true=监听目录 .md 变更并热重载缓存（不重启进程）
AGENT_PLAYBOOK_WATCH=true
# true=关键词 ∪ 语义召回（需 Qdrant + Embedding）；失败回退纯关键词
AGENT_PLAYBOOK_SEMANTIC_ENABLED=true
QDRANT_COLLECTION_PLAYBOOKS=platform_playbooks
AGENT_PLAYBOOK_SEMANTIC_SCORE_THRESHOLD=0.35

# 知识库：图片 VL / 表格行数上限（见 docs/architecture/05-qdrant-rag.md）
KNOWLEDGE_VISION_ENABLED=true
KNOWLEDGE_VISION_MODEL=qwen-vl-plus
KNOWLEDGE_VISION_TIMEOUT_SECONDS=120
KNOWLEDGE_VISION_MAX_SIDE=1280
KNOWLEDGE_IMAGE_MAX_BYTES=8388608
KNOWLEDGE_TABLE_MAX_ROWS=2000

AGENT_DEBUG_TRACE=true

# 工具 schema 两段式（默认 false）：先绑名+短描述，同名首调解锁后再注入完整参数 schema
# 与 select_tool_subset / resume 兼容；验证后再开
AGENT_TOOL_SCHEMA_TWOPHASE=false

DM_HOST=
DM_PORT=5236
DM_USER=
DM_PASSWORD=
DM_READ_ONLY=true
# 可选：无 dmPython 时 JDBC 回退（需 uv sync --extra entity-sync）
# DM_JDBC_JAR=D:/dmdbms/drivers/jdbc/DmJdbcDriver18.jar
ENTITY_SYNC_TABLES=p_device,p_device_variable
QDRANT_COLLECTION_ENTITIES=platform_entities
